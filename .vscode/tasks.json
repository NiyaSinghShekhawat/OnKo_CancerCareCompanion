{
  "version": "2.0.0",
  "tasks": [
    { "label": "API: seed DB", "type": "shell", "command": "python -m core.seed", "options": { "cwd": "${workspaceFolder}/apps/api" } },
    { "label": "API: run", "type": "shell", "command": "uvicorn main:app --reload --port 8000", "options": { "cwd": "${workspaceFolder}/apps/api" }, "isBackground": true },
    { "label": "Web: run", "type": "shell", "command": "npm run dev", "options": { "cwd": "${workspaceFolder}/apps/web" }, "isBackground": true },
    { "label": "Run everything", "dependsOn": ["API: run", "Web: run"], "dependsOrder": "parallel" },
    { "label": "API: tests", "type": "shell", "command": "python -m pytest -q tests", "options": { "cwd": "${workspaceFolder}/apps/api" } }
  ]
}
