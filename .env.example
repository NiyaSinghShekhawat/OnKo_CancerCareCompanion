# ---------- Backend (apps/api) ----------
DATABASE_URL=sqlite:///./onko.db
# For Supabase (Mumbai region, Session pooler — see docs/core.md):
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
FRONTEND_ORIGIN=http://localhost:3000

# ---------- Deployment (core) ----------
# Shared access code for a deployed demo. When set, every API call (except WhatsApp's webhook and /docs)
# must send header X-Access-Code with this value, else 401. Leave empty for local dev and tests.
DEMO_ACCESS_CODE=
# false → POST /demo/reset and POST /demo/advance-day answer 404 (so nobody can wipe a deployed demo). Default true.
DEMO_ROUTES_ENABLED=true

# ---------- AI (Shreyan) ----------
AI_PROVIDER=anthropic            # anthropic | gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ---------- WhatsApp / Twilio (Shreyan) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEMO_PATIENT_WHATSAPP=whatsapp:+91XXXXXXXXXX
