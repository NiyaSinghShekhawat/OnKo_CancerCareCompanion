# ---------- Backend (apps/api) ----------
DATABASE_URL=sqlite:///./onko.db
# For shared Supabase instead: postgresql://postgres:<password>@<host>:5432/postgres
FRONTEND_ORIGIN=http://localhost:3000

# ---------- AI (Shreyan) ----------
AI_PROVIDER=anthropic            # anthropic | gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ---------- WhatsApp / Twilio (Shreyan) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEMO_PATIENT_WHATSAPP=whatsapp:+91XXXXXXXXXX
PATIENT_LOGIN_URL=http://localhost:3000/patient/login
CAREGIVER_LOGIN_URL=http://localhost:3000/caregiver/login
# Local-only helpers. Keep false in shared/production environments.
ONKO_DEMO_OTP_ECHO=false
ONKO_DEMO_CREDENTIAL_ECHO=false
